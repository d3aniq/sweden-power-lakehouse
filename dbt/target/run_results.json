ar,\n    mimer_mwh,\n    scb_mwh,\n    mimer_mwh - scb_mwh                             as diff_mwh,\n    abs(mimer_mwh - scb_mwh)                        as abs_diff_mwh,\n    case\n        when scb_mwh != 0\n        then round((mimer_mwh - scb_mwh) / scb_mwh * 100, 2)\n    end                                             as diff_pct,\n    -- Inside SCB's own rounding there is no disagreement to explain.\n    abs(mimer_mwh - scb_mwh) <= 500\n                                                    as within_rounding\nfrom wide\nwhere mimer_mwh is not null\n  and scb_mwh is not null", "relation_name": "`workspace`.`gold`.`source_reconciliation`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-17T09:48:14.667249Z", "completed_at": "2026-09-17T09:48:14.708209Z"}, {"name": "execute", "started_at": "2026-09-17T09:48:14.713858Z", "completed_at": "2026-09-17T09:48:14.713871Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.05066108703613281, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.sweden_power_lakehouse.dbt_utils_unique_combination_of_columns_production_monthly_source__area__category__month.1a8eeb2bf6", "compiled": true, "compiled_code": "\n\n\n\n\n\nwith validation_errors as (\n\n    select\n        source, area, category, month\n    from `workspace`.`gold`.`production_monthly`\n    group by source, area, category, month\n    having count(*) > 1\n\n)\n\nselect *\nfrom validation_errors\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-17T09:48:14.708880Z", "completed_at": "2026-09-17T09:48:14.730491Z"}, {"name": "execute", "started_at": "2026-09-17T09:48:14.733510Z", "completed_at": "2026-09-17T09:48:14.733525Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 0.06931138038635254, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.sweden_power_lakehouse.energy_balance_silver_to_gold", "compiled": true, "compiled_code": "\n\nwith silver_total as (\n\n    select sum(value_mwh) as total_mwh\n    from (\n        select area, category, month, sum(value_mwh) as value_mwh,\n               count(*) as hours_present,\n               dayofmonth(last_day(month)) * 24 as hours_expected\n        from `workspace`.`silver`.`production_hourly`\n        group by area, category, month\n    )\n    where hours_present = hours_expected\n\n),\n\ngold_total as (\n\n    select sum(value_mwh) as total_mwh\n    from `workspace`.`gold`.`production_monthly`\n    where source = 'mimer'\n\n)\n\nselect\n    s.total_mwh as silver_mwh,\n    g.total_mwh as gold_mwh,\n    s.total_mwh - g.total_mwh as lost_mwh\nfrom silver_total s\ncross join gold_total g\nwhere abs(s.total_mwh - g.total_mwh) > 1", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-17T09:48:14.716385Z", "completed_at": "2026-09-17T09:48:14.735735Z"}, {"name": "execute", "started_at": "2026-09-17T09:48:14.750261Z", "completed_at": "2026-09-17T09:48:14.750276Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.044220924377441406, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.sweden_power_lakehouse.not_null_production_monthly_area.ee97c15a36", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect area\nfrom `workspace`.`gold`.`production_monthly`\nwhere area is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-17T09:48:14.736486Z", "completed_at": "2026-09-17T09:48:14.766940Z"}, {"name": "execute", "started_at": "2026-09-17T09:48:14.780672Z", "completed_at": "2026-09-17T09:48:14.780688Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.06568217277526855, "adapter_response": {}, "message": 