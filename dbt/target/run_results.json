  ) as version_rank\n    from parsed\n\n)\n\nselect\n    'mimer'                                     as source,\n    d.area,\n    m.category,\n    m.measure,\n    d.ts,\n    cast(d.ts as date)                          as date,\n    cast(date_trunc('month', d.ts) as date)     as month,\n    d.value_mwh,\n    d.published_at,\n    d.source_file,\n    current_timestamp()                         as processed_at\n\nfrom deduplicated d\nleft join `workspace`.`silver`.`category_mapping` m\n    on  d.production_type = m.source_category\n    and m.source = 'mimer'\nwhere d.version_rank = 1", "relation_name": "`workspace`.`silver`.`production_hourly`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-17T09:48:14.154031Z", "completed_at": "2026-09-17T09:48:14.188951Z"}, {"name": "execute", "started_at": "2026-09-17T09:48:14.191728Z", "completed_at": "2026-09-17T09:48:14.191743Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 0.13119745254516602, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.sweden_power_lakehouse.accepted_values_category_mapping_source__mimer__scb.20769f0337", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        source as value_field,\n        count(*) as n_records\n\n    from `workspace`.`silver`.`category_mapping`\n    group by source\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'mimer','scb'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-17T09:48:14.207222Z", "completed_at": "2026-09-17T09:48:14.262081Z"}, {"name": "execute", "started_at": "2026-09-17T09:48:14.263233Z", "completed_at": "2026-09-17T09:48:14.263255Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.06733822822570801, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.sweden_power_lakehouse.hourly_profile", "compiled": true, "compiled_code": "\n\n\n\nselect\n    area,\n    category,\n    year(ts)                                        as year,\n    hour(ts)                                        as hour_of_day,\n    round(avg(value_mwh), 1)                        as avg_mwh,\n    round(percentile_approx(value_mwh, 0.5), 1)     as median_mwh,\n    round(min(value_mwh), 1)                        as min_mwh,\n    round(max(value_mwh), 1)                        as max_mwh,\n    count(*)                                        as observations\nfrom `workspace`.`silver`.`production_hourly`\ngroup by area, category, year(ts), hour(ts)", "relation_name": "`workspace`.`gold`.`hourly_profile`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-17T09:48:14.210957Z", "completed_at": "2026-09-17T09:48:14.264713Z"}, {"name": "execute", "started_at": "2026-09-17T09:48:14.267648Z", "completed_at": "2026-09-17T09:48:14.267665Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.07051825523376465, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.sweden_power_lakehouse.production_monthly", "compiled": true, "compiled_code": "\n\n\n\nwith per_month as (\n\n    select\n        area,\n        category,\n        month,\n        sum(value_mwh)                      as value_mwh,\n        count(*)                            as hours_present,\n        dayofmonth(last_day(month)) * 24    as hours_expected\n    from `workspace`.`silver`.`production_hourly`\n    group by area, category, month\n\n),\n\nmimer as (\n\n    select\n        'mimer' as source,\n        area,\n        category,\n        month,\n        value_mwh\n    from per_month\n    where hours_present = hours_expected\n\n),\n\nscb as (\n\n    select\n        'scb' as source,\n        area,\n        category,\n        month,\n        value_mwh\n    from `workspace`.`silver`.`production_monthly`\n    where measure = 'production'\n      and availability = 'reported'\n\n)\n\nselect * from mimer\nunion all\nselect * from scb", "relation_name": "`workspace`.`gold`.`production_monthly`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-17T09:48:14.214436Z", "completed_at": "2026-09-17T09:48:14.270544Z"}, {"name": "execute", "started_at": "2026-09-17T09:48:14.274583Z", "completed_at": "2026-09-17T09:48:14.274597Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.0760807991027832, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.sweden_power_lakehouse.excluded_months", "compiled": true, "compiled_code": "\n\n\n\nselect\n    area,\n    category,\n    month,\n    count(*)                            as hours_present,\n    dayofmonth(last_day(month)) * 24    as hours_expected\nfrom `workspace`.`silver`.`production_hourly`\ngroup by area, category, month\nhaving count(*) != dayofmonth(last_day(month)) * 24", "relation_name": "`workspace`.`gold`.`excluded_months`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-17T09:48:14.217525Z", "completed_at": "2026-09-17T09:48:14.269866Z"}, {"name": "execute", "started_at": "2026-09-17T09:48:14.276517Z", "completed_at": "2026-09-17T09:48:14.276533Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 0.07697200775146484, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.sweden_power_lakehouse.accepted_values_production_hourly_area__SE1__SE2__SE3__SE4.1e02f2d233", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        area as value_field,\n        count(*) as n_records\n\n    from `workspace`.`silver`.`production_hourly`\n    group by area\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'SE1','SE2','SE3','SE4'\n)\n\n\n", "relation_name": null, "